{
  "name": "fwqaaq-blog-worker",
  "private": true,
  "description": "Cloudflare Worker: static hosting + x402-paid content API",
  "type": "module",
  "scripts": {
    "new-post": "node scripts/new-post.ts",
    "dev": "node src/util/resume/index.js && MODE=DEV node --watch main.js",
    "build": "node src/util/resume/index.js && MODE=PRO node main.js",
    "preview": "MODE=PRE node --watch main.js",
    "deploy": "npm run worker:deploy",
    "worker:dev": "npm run build && wrangler dev --port 8787",
    "worker:deploy": "npm run build && wrangler deploy",
    "worker:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@csstools/postcss-minify": "^3.0.0",
    "@shikijs/rehype": "^4.3.1",
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "@x402/hono": "^2.17.0",
    "@x402/paywall": "^2.17.0",
    "dotenv": "^17.2.3",
    "hono": "^4.12.27",
    "mdast-util-toc": "^7.1.0",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^11.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "viem": "^2.54.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260703.1",
    "@types/node": "^24.10.0",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=24"
  }
}
