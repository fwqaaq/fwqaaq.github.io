{
  "tasks": {
    "dev": "deno run -A src/util/resume/index.js &&MODE=DEV deno run -A --unstable-hmr main.js",
    "build": "deno run -A src/util/resume/index.js &&MODE=PRO deno run -A main.js",
    "preview": "MODE=PRE deno run -A --unstable-hmr main.js"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "indentWidth": 2,
    "useTabs": false,
    "lineWidth": 80,
    "include": [
      "src/**/*.js",
      "main.js",
      "public/JavaScript/*.js",
      "scripts/*.ts",
      "**/*.json"
    ]
  },
  "imports": {
    "@csstools/postcss-minify": "npm:@csstools/postcss-minify@^2.0.4",
    "@std/io": "jsr:@std/io",
    "fs": "https://deno.land/std@0.194.0/fs/mod.ts",
    "type-mdast": "https://cdn.jsdelivr.net/npm/@types/mdast@4.0.3/index.d.ts",
    "unified": "https://esm.sh/unified@11.0.5",
    "mdast-util-toc": "https://esm.sh/mdast-util-toc@7.1.0",
    "unified/index.d.ts": "https://esm.sh/unified@11.0.5/index.d.ts",
    "unist-util-visit": "https://esm.sh/unist-util-visit@5.0.0",
    "remark-parse": "https://esm.sh/remark-parse@10.0.2",
    "remark-rehype": "https://esm.sh/remark-rehype@10.1.0",
    "rehype-raw": "https://esm.sh/rehype-raw@6.1.1",
    "rehype-stringify": "https://esm.sh/rehype-stringify@9.0.3",
    "rehype-slug": "https://esm.sh/rehype-slug@5.1.0",
    "rehype-autolink-headings": "https://esm.sh/rehype-autolink-headings@6.1.1",
    "@shikijs/rehype": "https://esm.sh/@shikijs/rehype@1.12.0",
    "remark-gfm": "https://esm.sh/remark-gfm@3.0.1",
    "yaml": "https://deno.land/std@0.194.0/yaml/mod.ts",
    "Command": "https://deno.land/x/cliffy@v1.0.0-rc.3/command/mod.ts",
    "datetime": "https://deno.land/std@0.200.0/datetime/format.ts",
    "postcss": "npm:postcss@^8.5.6",
    "autoprefixer": "npm:autoprefixer@^10.4.21",
    "postcss-preset-env": "npm:postcss-preset-env@^10.4.0",
    "@cloudflare/workers-types": "https://cdn.jsdelivr.net/npm/@cloudflare/workers-types@latest/index.ts",
    "pdf-lib": "https://unpkg.com/pdf-lib@1.17.1/es/index.d.ts",
    "dotenv": "jsr:@std/dotenv"
  }
}